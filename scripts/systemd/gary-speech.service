[Unit]
# Installed as a USER unit (systemctl --user), not a system unit. The AIY
# voiceHAT is held exclusively by PulseAudio, which runs inside the pi user's
# systemd session. A system-scope service cannot reach it: aplay fails with
# "Device or resource busy" on the hardware device and cannot find the Pulse
# socket on "default", so Gary moves his mouth in silence. Running in the user
# session puts these services alongside PulseAudio, where audio just works.
# Lingering (loginctl enable-linger) makes that session start at power-on
# without anyone logging in.
Description=Gary push-to-talk speech recognition (AIY button and Vosk)
Documentation=https://github.com/Lukeluca/InMoov-RaspberryPi-AIY-Arduino
After=gary-brain.service
Wants=gary-brain.service
PartOf=gary.target

[Service]
Type=simple
WorkingDirectory=/home/pi/gary/brain
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/gary/brain/gary_local_speech_recognition.py
# Loading the Vosk model takes roughly 20 seconds, so give it room before a
# restart is considered, and do not thrash if the microphone is missing.
Restart=on-failure
RestartSec=15

[Install]
WantedBy=gary.target
