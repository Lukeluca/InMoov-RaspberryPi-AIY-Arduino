# Settings the servo API changes while it is running. It writes this file
# itself, so there is usually no reason to create it by hand — the console's
# volume slider will. Copy it to .env only if you want a starting value.
#
# .env is gitignored.

# How loud Gary speaks: a gain of 0.0 to 1.0 applied to the audio itself, not to
# the system mixer, so it does not change the volume of anything else on the Pi.
# Whatever is in here wins over GARY_TTS_VOLUME in the systemd unit, and is read
# again for every utterance, so a change applies to the next thing he says.
GARY_TTS_VOLUME=0.35
